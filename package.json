{
  "name": "ai-extension-collection",
  "version": "0.12.0",
  "private": true,
  "description": "Pi package for the ai-extension-collection plugins that ship a pi adapter, pi-only extension, pi agents (plugins/<name>/pi/), or Agent Skills (plugins/<name>/skills/).",
  "type": "module",
  "keywords": ["pi-package"],
  "scripts": {
    "test": "bash plugins/gitauto/scripts/run-tests.sh && bash plugins/coding-guides/hooks/coding-guides-pre-tool-use.test.sh && bash plugins/coding-guides/hooks/inject-guides.test.sh && npm run test:pi",
    "test:pi": "node --test plugins/*/pi/*.test.ts libs/*/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "pi": {
    "extensions": [
      "./plugins/coding-guides/pi/index.ts",
      "./plugins/gitauto/pi/index.ts",
      "./plugins/pi-clear/pi/index.ts",
      "./plugins/pi-clear-on-exit/pi/index.ts",
      "./plugins/pi-context/pi/index.ts",
      "./plugins/pi-rename/pi/index.ts",
      "./plugins/pi-startup-splash/pi/index.ts",
      "./plugins/pi-statusline/pi/index.ts",
      "./plugins/pi-summarize/pi/index.ts"
    ],
    "skills": [
      "./plugins/coding-guides/skills",
      "./plugins/doc-authoring/skills",
      "./plugins/go-idioms/skills"
    ],
    "subagents": {
      "agents": ["./plugins/architects/pi/agents"]
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
