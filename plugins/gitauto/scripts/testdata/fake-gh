#!/usr/bin/env bash
# Fake gh for the ship and pi tests; its state lives in $FAKE_GH. Accounts:
# `logins` (space-separated, default "tester") are logged in, `push` lists those
# that can push to the repo, `read` those that can only read it; any other login
# gets a 404. Each call is logged with its token to `tokens`.
s="$FAKE_GH"; printf '%s\n' "$*" >> "$s/log"
printf '%s\t%s\n' "${GH_TOKEN:-${GH_ENTERPRISE_TOKEN:-}}" "$*" >> "$s/tokens"
json=''; jq=''; hostname=github.com; user=''; prev=''
for a in "$@"; do
  case "$prev" in --json) json="$a" ;; --jq) jq="$a" ;; --hostname) hostname="$a" ;; --user) user="$a" ;; esac
  prev="$a"
done
logins="$(cat "$s/logins" 2>/dev/null || echo tester)"
has() { [[ " $(cat "$s/$1" 2>/dev/null) " == *" $2 "* ]]; }
case "${1:-} ${2:-}" in
  'auth status')
    if [[ "$json" == hosts ]]; then
      [[ ! -f "$s/nojson" ]] || { printf 'unknown flag: --json\n' >&2; exit 1; }
      entries=''
      for l in $logins; do entries+="${entries:+,}{\"login\":\"$l\",\"state\":\"success\",\"host\":\"$hostname\"}"; done
      printf '{"hosts":{"%s":[%s]}}\n' "$hostname" "$entries" | jq -r "${jq:-.}"
      exit
    fi
    # auth-only: the one host with a working login; a wider check fails.
    [[ ! -f "$s/auth-only" || "$*" == "auth status --hostname $(cat "$s/auth-only")" ]] ;;
  'auth token') [[ " $logins " == *" $user "* ]] || exit 1; printf 'tok-%s\n' "$user" ;;
  'api '*)
    [[ ! -f "$s/apidown" ]] || { printf 'error connecting to api.github.com\n' >&2; exit 1; }
    login="${GH_TOKEN:-${GH_ENTERPRISE_TOKEN:-}}"; login="${login#tok-}"
    if has push "$login"; then printf '{"permissions":{"push":true}}\n' | jq -r "${jq:-.}"
    elif has read "$login"; then printf '{"permissions":{"push":false}}\n' | jq -r "${jq:-.}"
    else printf '{"message":"Not Found","status":"404"}'; printf 'gh: Not Found (HTTP 404)\n' >&2; exit 1
    fi ;;
  'repo view') exit 1 ;;
  'pr create')
    # prcreate-error: gh refuses to create the PR, as for an Enterprise Managed User.
    if [[ -f "$s/prcreate-error" ]]; then
      printf 'pull request create failed: GraphQL: Unauthorized: As an Enterprise Managed User, you cannot access this content (createPullRequest)\n' >&2; exit 1
    fi
    while [[ $# -gt 0 ]]; do case "$1" in --head) printf '%s' "$2" > "$s/head" ;; --title) printf '%s' "$2" > "$s/title" ;; --body) printf '%s' "$2" > "$s/body" ;; esac; shift; done
    git rev-parse HEAD > "$s/oid"
    printf 'https://github.com/o/r/pull/7\n' ;;
  'pr view')
    # prerror: the active account cannot see the repository.
    if [[ -f "$s/prerror" ]]; then
      printf "GraphQL: Could not resolve to a Repository with the name 'o/r'. (repository)\n" >&2; exit 1
    fi
    [[ -f "$s/head" ]] || { printf 'no pull requests found for branch\n' >&2; exit 1; }
    state="$(cat "$s/state" 2>/dev/null || echo OPEN)"
    case "$json" in
      number,state,url) printf '7\t%s\thttps://github.com/o/r/pull/7\n' "$state" ;;
      number,state,headRefName) printf '7\t%s\t%s\n' "$state" "$(cat "$s/head")" ;;
      number,state,title) printf '%s#7 %s\n' "${state,,}" "$(cat "$s/title")" ;;
      number) printf '7\n' ;;
      title) cat "$s/title"; printf '\n' ;;
      headRefOid) cat "$s/oid" ;;
      body) cat "$s/body"; printf '\n' ;;
    esac ;;
  'pr checks')
    if [[ -f "$s/cislow" && -z "$json" ]]; then sleep 20; fi
    # cilate: a check that registered after the watch ended; merge's check sees it pending once.
    if [[ -f "$s/cilate" && "$*" != *--watch* ]]; then rm "$s/cilate"; printf 'lint\tpending\n'; exit 8; fi
    # cidown: GitHub is unreachable, so every checks call errors like a reset connection.
    if [[ -f "$s/cidown" ]]; then printf 'Post "https://api.github.com/graphql": connection reset by peer\n' >&2; exit 1; fi
    if [[ -f "$s/cifail" ]]; then
      if [[ "$json" == bucket ]]; then printf 'pass\nfail\n'; exit 0; fi
      if [[ -n "$json" ]]; then printf 'build\thttps://github.com/o/r/actions/runs/99/job/1\n'; exit 0; fi
      printf 'build\tfail\n'; exit 1
    fi
    printf 'all checks passed\n' ;;
  'run view') printf 'build\tTest\t2026-01-02T03:04:05.1234567Z --- FAIL: TestThing\nbuild\tTest\t2026-01-02T03:04:05.2Z expected 1, got 2\n' ;;
  'pr merge') printf '%s\n' "$*" > "$s/merge"; printf 'MERGED' > "$s/state" ;;
  *) printf 'fake gh: unsupported %s\n' "$*" >&2; exit 9 ;;
esac
